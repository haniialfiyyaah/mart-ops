    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO ops.tickets (merchant_id, question, ai_answer, reason, status)\nVALUES (\n  '{{ $json.merchant_id }}',\n  '{{ String($json.question || \"\").replace(/'/g, \"''\") }}',\n  '{{ String($json.jawaban || \"\").replace(/'/g, \"''\") }}',\n  'guardrail_or_fallback',\n  'open'\n);",
        "options": {}
      },
