        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"jawaban\": { \"type\": \"string\" },\n    \"data_dipakai\": { \"type\": \"array\", \"items\": { \"type\": \"string\" } },\n    \"confidence\": { \"type\": \"number\" },\n    \"perlu_eskalasi\": { \"type\": \"boolean\" }\n  },\n  \"required\": [\"jawaban\", \"data_dipakai\", \"confidence\", \"perlu_eskalasi\"],\n  \"additionalProperties\": false\n}"
      },
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
