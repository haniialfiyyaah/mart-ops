    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT hari_data_terakhir::text AS hari_data_terakhir FROM core.data_info LIMIT 1;",
        "options": {}
      },
      "id": "0a4754df-46da-4249-93b3-88b24fa988d7",
      "name": "Load Data Day",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
