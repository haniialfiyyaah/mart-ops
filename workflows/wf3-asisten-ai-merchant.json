        }
      }
    },
    {
      "parameters": {
        "jsCode": "const q = $('Normalize Question').first().json;\nconst day = $('Load Data Day').first().json;\nconst item = $input.first().json;\n\nlet parsed = item;\ntry {\n  if (typeof item.output === 'string') parsed = JSON.parse(item.output);\n  else if (item.jawaban !== undefined) parsed = item;\n  else if (item.output && typeof item.output === 'object') parsed = item.output;\n} catch (e) {\n  parsed = { jawaban: '', data_dipakai: [], confidence: 0, perlu_eskalasi: true };\n}\n\nconst confidence = Number(parsed.confidence ?? 0);\nconst perlu = Boolean(parsed.perlu_eskalasi) || confidence < 0.55 || !parsed.jawaban;\n\nreturn [{\n  json: {\n    merchant_id: q.merchant_id,\n    question: q.question,\n    hari_data_terakhir: day.hari_data_terakhir,\n    jawaban: parsed.jawaban || '',\n    data_dipakai: parsed.data_dipakai || [],\n    confidence,\n    perlu_eskalasi: perlu,\n    status: perlu ? 'eskalasi_cs' : 'dijawab',\n  },\n}];"
      },
      "id": "ab605ba2-cfdb-45ba-adbe-856a4cde4345",
      "name": "Guardrail Check",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1456,
        272
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "ok",
              "leftValue": "={{ $json.perlu_eskalasi }}",
              "rightValue": false,
              "operator": {
                "type": "boolean",
                "operation": "false"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "f999db81-e566-4915-9ee0-68296d2eda96",
      "name": "Pass Guardrail?",
