# Salin menjadi .env:   cp .env.example .env     (PowerShell 7: Copy-Item .env.example .env)
# Jangan commit .env. Semua nilai di bawah hanya untuk laptop/VPS latihan, bukan kredensial nyata.

# Versi n8n & task runners: harus sama persis (jangan diubah tanpa pengumuman instruktur).
N8N_VERSION=2.44.7
N8N_RUNNERS_AUTH_TOKEN=aien-lab-local-token

# Versi image pendukung
POSTGRES_VERSION=16.15-alpine
UPTIME_KUMA_VERSION=2.5.8
MOCK_API_IMAGE=node:24-alpine

# Kebijakan penyimpanan data eksekusi (sama dengan stack bersama Sesi 10)
EXECUTIONS_DATA_SAVE_ON_ERROR=all
EXECUTIONS_DATA_SAVE_ON_SUCCESS=all
EXECUTIONS_DATA_SAVE_ON_PROGRESS=false
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=336
EXECUTIONS_DATA_PRUNE_MAX_COUNT=10000

# PostgreSQL H8Mart (core.* dan ops.*)
PG_SUPERUSER_PASSWORD=h8mart-admin-lab
PG_READER_PASSWORD=mcp-reader-lab
PG_WRITER_PASSWORD=ops-writer-lab

# Mock API (Merchant Stock, Payment, Notification). Dikirim di header X-Api-Key.
MOCK_API_KEY=h8mart-mock-key

# Token Header Auth untuk Webhook event H8Mart (header X-H8Mart-Token)
WEBHOOK_TOKEN=h8mart-webhook-lab

# Telegram: token bot dari @BotFather TIDAK ditaruh di sini; simpan hanya di credential n8n (Telegram API). chat_id dicatat di ops.telegram_merchants.

# API key LLM. TIDAK dibaca stack: n8n hanya memakai key dari credential OpenAI API di editor n8n.
# Baris ini sekadar tempat menyimpan key sementara di .env lokal (tidak pernah di-commit); boleh dibiarkan kosong.
# OpenAI: key dibagikan instruktur (jangan dibagikan ulang). Anthropic: opsional, hanya bila kalian punya key sendiri.
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# N8N_WEBHOOK_URL (Production URL webhook dan resume URL node Wait) dibentuk otomatis dari N8N_HOST_PORT di compose.yaml.
# Port host. Default sengaja berbeda dari stack Phase 3 lain (n8n 5678, Kuma 3001, postgres 5433).
# Ubah bila bentrok (mock-api 8080 sering dipakai aplikasi lain).
N8N_HOST_PORT=5690
PG_HOST_PORT=5440
MOCK_API_HOST_PORT=8080
KUMA_HOST_PORT=3011

# ---- Hanya untuk VPS (compose.vps.yaml). Di laptop biarkan terkomentar.
# DOMAIN_NAME=<nama-kalian>.duckdns.org
# SSL_EMAIL=<email-kalian>
# N8N_ENCRYPTION_KEY=<hasil: openssl rand -hex 32>
# CADDY_VERSION=2.11.7-alpine
